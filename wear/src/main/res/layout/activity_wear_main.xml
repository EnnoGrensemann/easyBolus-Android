<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/wear_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#9AA0A6"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wear_bg_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:text="---"
            android:textColor="#00A884"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wear_trend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:includeFontPadding="false"
            android:text=""
            android:textColor="#00A884"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/wear_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/wear_waiting"
        android:textColor="#E3E3E8"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/wear_iob_cob"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:maxLines="1"
        android:text=""
        android:textColor="#8FD0E8"
        android:textSize="12sp" />

    <Button
        android:id="@+id/wear_sync_button"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/wear_btn_bg"
        android:minWidth="112dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/wear_btn_sync"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />
</LinearLayout>
