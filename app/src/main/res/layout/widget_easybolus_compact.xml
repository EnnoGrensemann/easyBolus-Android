<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <!-- Linke Spalte (4x1 Pixel): BZ+Trend links, IOB/COB gestapelt rechts, Δ + Zeit zentriert darunter -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.05"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_status_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textSize="11sp"
                    android:includeFontPadding="false"
                    android:textColor="#00A884"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/widget_bg_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="---"
                    android:textSize="32sp"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/widget_text_primary" />

                <TextView
                    android:id="@+id/widget_trend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text=""
                    android:textSize="18sp"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_text_primary" />

                <!-- IOB & COB Badges rechts neben BZ/Trend übereinander -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/widget_iob"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="58dp"
                        android:gravity="center"
                        android:background="@drawable/widget_pill_iob"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:paddingTop="3.5dp"
                        android:paddingBottom="3.5dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="0,00 IE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFeatureSettings="tnum"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/widget_cob"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="58dp"
                        android:gravity="center"
                        android:background="@drawable/widget_pill_cob"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:paddingTop="3.5dp"
                        android:paddingBottom="3.5dp"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="0,0 g"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFeatureSettings="tnum"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="11sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/widget_text_secondary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Dezente Trennlinie -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/widget_divider"
            android:contentDescription="@null" />

        <!-- Rechte Spalte: Maximale Breite für Live-Mini-Chart ohne Y-Achse -->
        <ImageView
            android:id="@+id/widget_chart_image"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:scaleType="fitXY"
            android:contentDescription="@string/app_name" />
    </LinearLayout>
</FrameLayout>
